{
  "name": "lockeen-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "setup:check": "node scripts/validate-env.mjs",
    "security:frontend-env": "node scripts/check-frontend-secrets.mjs",
    "security:real-mode": "node scripts/check-real-mode-mock-guards.mjs",
    "security:rls": "node scripts/check-rls-baseline.mjs",
    "ai-tutor:check": "node scripts/check-ai-tutor-production.mjs",
    "tutor:check": "node scripts/check-tutor-contracts.mjs",
    "planner:check": "node scripts/check-study-planner.mjs",
    "flashcards:check": "node scripts/check-flashcard-generation.mjs",
    "quiz:check": "node scripts/check-quiz-generation.mjs",
    "ci": "npm run setup:check && npm run security:frontend-env && npm run security:real-mode && npm run security:rls && npm run ai-tutor:check && npm run tutor:check && npm run planner:check && npm run flashcards:check && npm run quiz:check && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "stripe": "^22.2.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.16"
  }
}
