# Lockeen frontend env
# Copy to .env.local for local dev. Never commit .env.local.

# mock = local demo without backend
# real = Supabase-backed data path
VITE_API_MODE=mock

# mock = local demo session
# supabase = Supabase Auth session
VITE_AUTH_MODE=mock

# Required only when VITE_API_MODE=real or VITE_AUTH_MODE=supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backward-compatible alias. Prefer VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_ANON_KEY=

# Optional client-side analytics; keep empty until configured.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional client AI mode. mock keeps UI local; real calls /api/ai-study-assist through src/services/ai.js.
VITE_AI_MODE=mock

# Server-only AI env for Vercel/api functions. Never prefix with VITE.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_QUOTA=20

# Optional comma-separated admin emails for server-only admin APIs.
# support.lockeen@gmail.com is allowed by default in code.
LOCKEEN_ADMIN_EMAILS=
